# Database (individual fields — used by settings.py)
DB_NAME=ethio_listings
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Use postgis in Docker; use postgresql for local dev without GDAL installed
DB_ENGINE=django.contrib.gis.db.backends.postgis

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary (leave blank to use local media/ folder in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ethiolistings.com

FRONTEND_URL=http://localhost:3000

# AI (leave blank — AI generation will return 503, form works manually)
OPENAI_API_KEY=

MAPBOX_PUBLIC_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=

# Sentry (leave blank to disable)
SENTRY_DSN=
ENVIRONMENT=development

# Redis + Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=
